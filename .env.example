# ╔══════════════════════════════════════════════════════════════════╗
# ║                   LOCAL AI HUB — Plantilla .env                  ║
# ╚══════════════════════════════════════════════════════════════════╝
#
# Forma rápida de generar tu .env:
#     bash scripts/init-env.sh
# Crea un .env con secretos aleatorios + tus valores pre-rellenados.
#
# Si prefieres rellenarlo a mano:
#     1. Copia este archivo a .env
#     2. Cambia todos los placeholders marcados con CAMBIAR_*
#     3. Despliega con: bash scripts/start.sh
#
# ──────────────────────────────────────────────────────────────────
# La mayoría de cosas también se pueden cambiar más tarde desde el
# dashboard (Ajustes), SIN tocar este archivo:
#   - Proveedor IA (Ollama / OpenAI) + API key + modelo
#   - Prompts personalizados para notas y recordatorios
#   - Whitelist de números WhatsApp
#   - Token de Telegram y usuarios autorizados
#   - URL del servidor Ollama y modelos
# ──────────────────────────────────────────────────────────────────


# ═════════════════════════════════════════════════════════════════
# 1) PUERTOS (red local)
# ═════════════════════════════════════════════════════════════════
FRONTEND_PORT=3410
BACKEND_PORT=3411
POSTGRES_PORT=5438
REDIS_PORT=6385


# ═════════════════════════════════════════════════════════════════
# 2) POSTGRESQL — base de datos del backend
# ═════════════════════════════════════════════════════════════════
POSTGRES_USER=hubuser
POSTGRES_PASSWORD=CAMBIAR_password_aleatoria
POSTGRES_DB=local_ai_hub
DATABASE_URL=postgresql://hubuser:CAMBIAR_password_aleatoria@local-ai-hub-postgres:5432/local_ai_hub?schema=public


# ═════════════════════════════════════════════════════════════════
# 3) REDIS — caché y locks
# ═════════════════════════════════════════════════════════════════
REDIS_URL=redis://local-ai-hub-redis:6379


# ═════════════════════════════════════════════════════════════════
# 4) OPENWA — puente con WhatsApp
# ═════════════════════════════════════════════════════════════════
# scripts/init-env.sh autodetecta el SESSION_ID llamando a la API
# de OpenWA con tu API key. Si lo prefieres a mano:
#   http://<IP_OPENWA>:2887/sessions → SESSION ID
# ═════════════════════════════════════════════════════════════════
OPENWA_API_URL=http://192.168.8.200:2785/api
OPENWA_API_KEY=CAMBIAR_por_la_api_key_real_de_openwa
OPENWA_SESSION_ID=CAMBIAR_uuid_de_la_sesion
OPENWA_SESSION_NAME=chatbot-wa
OPENWA_SESSION_PHONE=34670209033


# ═════════════════════════════════════════════════════════════════
# 5) IA — proveedor por defecto
# ═════════════════════════════════════════════════════════════════
# Se puede cambiar en CALIENTE desde el dashboard
# (Ajustes → Proveedor IA), no hace falta tocar este archivo.
#
# AI_PROVIDER admite:
#   - "ollama" (default) — usa modelos locales del servidor Ollama
#   - "openai"           — usa la API de OpenAI o cualquier compatible
#                          (OpenRouter, Groq, Together AI…)
# ═════════════════════════════════════════════════════════════════
AI_PROVIDER=ollama
AI_TEMPERATURE=0.7

# ─── 5.a) Ollama (usado si AI_PROVIDER=ollama) ───────────────────
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_FALLBACK_URLS=http://192.168.8.200:11434
OLLAMA_DEFAULT_MODEL=llama3.2:1b
OLLAMA_TIMEOUT_MS=120000

# ─── 5.b) OpenAI / compatibles (usado si AI_PROVIDER=openai) ─────
# Sácala en: https://platform.openai.com/api-keys
# Si la dejas vacía y AI_PROVIDER=openai, el backend devolverá error
# claro pidiendo que la pegues desde el dashboard.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini


# ═════════════════════════════════════════════════════════════════
# 6) BACKEND — Node/Nest
# ═════════════════════════════════════════════════════════════════
NODE_ENV=production
BACKEND_INTERNAL_PORT=3411
BACKEND_PUBLIC_URL=http://192.168.8.200:3411

# Genera estos con: openssl rand -hex 32
BACKEND_API_KEY=CAMBIAR_genera_con_openssl_rand_hex_32
JWT_SECRET=CAMBIAR_genera_con_openssl_rand_hex_48

CORS_ORIGIN=http://192.168.8.200:3410,http://localhost:3410
LOG_LEVEL=info
TZ=Europe/Madrid
REMINDER_TZ=Europe/Madrid

# HSTS solo si SIRVES la app detrás de HTTPS (proxy TLS).
# En LAN sin HTTPS NO activar: rompe el dashboard al forzar https://.
# ENABLE_HSTS=true


# ═════════════════════════════════════════════════════════════════
# 7) WEBHOOK (OpenWA → Backend)
# ═════════════════════════════════════════════════════════════════
WEBHOOK_URL=http://192.168.8.200:3411/webhooks/openwa
WEBHOOK_SECRET=CAMBIAR_genera_con_openssl_rand_hex_32


# ═════════════════════════════════════════════════════════════════
# 8) FRONTEND — Next.js dashboard
# ═════════════════════════════════════════════════════════════════
NEXT_PUBLIC_API_URL=http://192.168.8.200:3411
NEXT_PUBLIC_WS_URL=ws://192.168.8.200:3411
NEXT_PUBLIC_APP_NAME="Local AI Hub"


# ═════════════════════════════════════════════════════════════════
# 9) CHAT — comportamiento del bot
# ═════════════════════════════════════════════════════════════════
CHAT_CONTEXT_MAX_MESSAGES=20
CHAT_SYSTEM_PROMPT="Eres un asistente util, conciso y directo. Respondes siempre en español a menos que el usuario hable en otro idioma."

# manual | private | ai | silent | maintenance  (private recomendado)
BOT_MODE_DEFAULT=private
OPEN_TO_ALL=false


# ═════════════════════════════════════════════════════════════════
# 10) WHATSAPP — números autorizados
# ═════════════════════════════════════════════════════════════════
# El backend normaliza cualquier formato razonable:
#   612345678  ·  +34612345678  ·  34 612 345 678
# y los convierte a 34XXXXXXXXX@c.us.
#
# Lo más cómodo: dejar estas dos vacías y configurar la whitelist
# desde el dashboard. Solo TEST_WHATSAPP_CHAT_ID es útil aquí.
# ═════════════════════════════════════════════════════════════════
TEST_WHATSAPP_CHAT_ID=34670209033@c.us
ALLOWED_CHAT_IDS=
ADMIN_CHAT_IDS=


# ═════════════════════════════════════════════════════════════════
# 11) RECORDATORIOS — parser
# ═════════════════════════════════════════════════════════════════
# Cuando el parser estándar no entiende una frase tipo "mañana a las 7
# avísame del médico", se la pasa a la IA para que la interprete.
# Pon a "false" para desactivar el fallback.
# ═════════════════════════════════════════════════════════════════
REMINDERS_AI_FALLBACK=true


# ═════════════════════════════════════════════════════════════════
# 12) POLLING — fallback cuando OpenWA no envía webhooks
# ═════════════════════════════════════════════════════════════════
POLL_ENABLED=true
POLL_INTERVAL_MS=5000


# ═════════════════════════════════════════════════════════════════
# 13) TELEGRAM — panel de control desde el móvil
# ═════════════════════════════════════════════════════════════════
# Cómo crear el bot:
#   1. Abre Telegram → @BotFather → /newbot → te da el TOKEN
#   2. Manda /start a tu bot recién creado
#   3. Manda /quien al bot para ver tu user id (con el bot ya conectado)
#
# Configurable también desde el dashboard (Ajustes → Telegram) sin
# tocar este archivo.
# ═════════════════════════════════════════════════════════════════
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_POLL_INTERVAL_MS=2000
