# ====================================================================
# LOCAL AI HUB - Plantilla .env
# ====================================================================
# Forma rapida de generar tu .env:
#     bash scripts/init-env.sh
# Eso crea un .env con secrets aleatorios + tus valores prerellenados.
# Solo te preguntara la OPENWA_API_KEY y opcionalmente Telegram.
#
# Si prefieres rellenarlo a mano: copia este archivo a .env y rellena
# los placeholders marcados con CAMBIAR_*.
# ====================================================================

# --- Puertos ---
FRONTEND_PORT=3410
BACKEND_PORT=3411
POSTGRES_PORT=5438
REDIS_PORT=6385

# --- PostgreSQL ---
POSTGRES_USER=hubuser
POSTGRES_PASSWORD=CAMBIAR_password_aleatoria
POSTGRES_DB=local_ai_hub
DATABASE_URL=postgresql://hubuser:CAMBIAR_password_aleatoria@local-ai-hub-postgres:5432/local_ai_hub?schema=public

# --- Redis ---
REDIS_URL=redis://local-ai-hub-redis:6379

# ====================================================================
# OpenWA (sesion 'chatbot-wa' por defecto)
# scripts/init-env.sh autodetecta OPENWA_SESSION_ID llamando a la API
# de OpenWA con tu OPENWA_API_KEY. Si lo prefieres a mano, sacalo en:
#   http://192.168.8.200:2887/sessions -> SESSION ID
# ====================================================================
OPENWA_API_URL=http://192.168.8.200:2785/api
OPENWA_API_KEY=CAMBIAR_por_la_api_key_real_de_openwa
OPENWA_SESSION_ID=CAMBIAR_uuid_de_la_sesion_chatbot-wa
OPENWA_SESSION_NAME=chatbot-wa
OPENWA_SESSION_PHONE=34670209033

# ====================================================================
# Ollama
# ====================================================================
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_FALLBACK_URLS=http://192.168.8.200:11434
OLLAMA_DEFAULT_MODEL=llama3.2:1b
OLLAMA_TIMEOUT_MS=120000

# ====================================================================
# Backend
# ====================================================================
NODE_ENV=production
BACKEND_INTERNAL_PORT=3411
BACKEND_PUBLIC_URL=http://192.168.8.200:3411

# Genera estos con: openssl rand -hex 32
BACKEND_API_KEY=CAMBIAR_genera_con_openssl_rand_hex_32
JWT_SECRET=CAMBIAR_genera_con_openssl_rand_hex_48

CORS_ORIGIN=http://192.168.8.200:3410,http://localhost:3410
LOG_LEVEL=info
TZ=Europe/Madrid
REMINDER_TZ=Europe/Madrid

# ====================================================================
# Webhook (OpenWA → Backend)
# ====================================================================
WEBHOOK_URL=http://192.168.8.200:3411/webhooks/openwa
WEBHOOK_SECRET=CAMBIAR_genera_con_openssl_rand_hex_32

# ====================================================================
# Frontend
# ====================================================================
NEXT_PUBLIC_API_URL=http://192.168.8.200:3411
NEXT_PUBLIC_WS_URL=ws://192.168.8.200:3411
NEXT_PUBLIC_APP_NAME="Local AI Hub"

# ====================================================================
# Chat
# ====================================================================
CHAT_CONTEXT_MAX_MESSAGES=20
CHAT_SYSTEM_PROMPT="Eres un asistente util, conciso y directo. Respondes siempre en español a menos que el usuario hable en otro idioma."

# ====================================================================
# Modo del bot (manual|private|ai|silent|maintenance)
# ====================================================================
BOT_MODE_DEFAULT=private
OPEN_TO_ALL=false

# ====================================================================
# WhatsApp numeros
# ====================================================================
TEST_WHATSAPP_CHAT_ID=34670209033@c.us
ALLOWED_CHAT_IDS=
ADMIN_CHAT_IDS=

# ====================================================================
# Polling
# ====================================================================
POLL_ENABLED=true
POLL_INTERVAL_MS=5000

# ====================================================================
# Telegram (configurable tambien desde el dashboard sin tocar este .env)
# Como crear el bot:
#   1. Abre Telegram → @BotFather → /newbot → te da el TOKEN
#   2. Manda /start a tu bot recien creado
#   3. Manda /quien al bot para ver tu user id (cuando este conectado al backend)
# ====================================================================
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_POLL_INTERVAL_MS=2000
