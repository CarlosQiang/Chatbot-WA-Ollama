# ====================================================================
# LOCAL WHATSAPP OLLAMA HUB - Environment Variables
# Copia este archivo a .env y rellena los valores
# ====================================================================

# --- Puertos (NO cambiar salvo colisión) ---
FRONTEND_PORT=3410
BACKEND_PORT=3411
POSTGRES_PORT=5438
REDIS_PORT=6385

# --- PostgreSQL ---
POSTGRES_USER=hubuser
POSTGRES_PASSWORD=changeme_supersecret
POSTGRES_DB=local_ai_hub
DATABASE_URL=postgresql://hubuser:changeme_supersecret@local-ai-hub-postgres:5432/local_ai_hub?schema=public

# --- Redis ---
REDIS_URL=redis://local-ai-hub-redis:6379

# ====================================================================
# OpenWA — conexión con tu instancia ya instalada
# ====================================================================
OPENWA_API_URL=http://192.168.8.200:2785/api
OPENWA_API_KEY=CAMBIAR_POR_TU_API_KEY
OPENWA_SESSION_ID=6d50d269-5457-46d0-be01-700ed73ae044
OPENWA_SESSION_NAME=bot-prueba

# Número del móvil que tiene WhatsApp escaneado en OpenWA (sin +, formato internacional).
# Este número (xxx@c.us) es siempre ADMIN automáticamente.
OPENWA_SESSION_PHONE=34670209033

# ====================================================================
# Ollama — modelo de IA
# Puedes cambiarlo también desde el dashboard (Ajustes → Ollama).
# El valor guardado en el dashboard tiene prioridad sobre este env.
# ====================================================================
# URL primaria
OLLAMA_BASE_URL=http://host.docker.internal:11434

# URLs de fallback (orden de prueba si la primaria cae). Coma-separadas.
# Ejemplo: OLLAMA_FALLBACK_URLS=http://192.168.8.200:11434,http://192.168.8.186:11434
OLLAMA_FALLBACK_URLS=

OLLAMA_DEFAULT_MODEL=llama3.2:1b
OLLAMA_TIMEOUT_MS=120000

# ====================================================================
# Backend
# ====================================================================
NODE_ENV=production
BACKEND_INTERNAL_PORT=3411
BACKEND_PUBLIC_URL=http://192.168.8.200:3411

# ⚠️ IMPORTANTE: define un valor REAL. Si lo dejas como
# "internal_change_me_token" o vacío, el backend solo aceptará
# peticiones desde loopback (127.0.0.1). Cualquier cliente remoto
# recibirá 401.
BACKEND_API_KEY=internal_change_me_token

JWT_SECRET=jwt_change_me_secret_long_random
CORS_ORIGIN=http://192.168.8.200:3410,http://localhost:3410
LOG_LEVEL=info

# Zona horaria (afecta al display y al parser de recordatorios).
# Si tu contenedor está en UTC y quieres "Europe/Madrid", añade
# también TZ=Europe/Madrid arriba.
TZ=Europe/Madrid
REMINDER_TZ=Europe/Madrid

# ====================================================================
# Webhook (OpenWA → Backend)
# ====================================================================
WEBHOOK_URL=http://192.168.8.200:3411/webhooks/openwa

# ⚠️ Configura un secret REAL. Si está vacío o es
# "webhook_secret_change_me", el webhook solo aceptará llamadas
# desde loopback. Para webhooks remotos OpenWA debe enviar el secret en:
#   - Header: x-webhook-secret
#   - Query : ?token=<secret>
#   - Path  : POST /webhooks/openwa/<secret>
WEBHOOK_SECRET=webhook_secret_change_me

# ====================================================================
# Frontend
# ====================================================================
NEXT_PUBLIC_API_URL=http://192.168.8.200:3411
NEXT_PUBLIC_WS_URL=ws://192.168.8.200:3411
NEXT_PUBLIC_APP_NAME="Local AI Hub"

# ====================================================================
# Chat
# ====================================================================
CHAT_CONTEXT_MAX_MESSAGES=20
CHAT_SYSTEM_PROMPT="Eres un asistente útil, conciso y directo. Respondes siempre en español a menos que el usuario hable en otro idioma."

# ====================================================================
# Modos del bot WhatsApp
# ====================================================================
# Modos:
#   manual       → solo procesa comandos enviados por admins.
#   private      → comandos + chat IA solo a whitelist y admins.  ⭐ RECOMENDADO
#   ai           → alias de private (orientado a IA conversacional).
#   silent       → no responde a nada.
#   maintenance  → responde "estoy en mantenimiento" solo a admins.
#
# Si no se setea, el default real es "private" (cerrado).
BOT_MODE_DEFAULT=private

# Si lo pones a "true" desactiva la whitelist (responde a todos).
# ⚠️ Solo úsalo si sabes lo que haces. Por defecto el bot SOLO responde
# a la whitelist + admins, incluso si la whitelist está vacía.
OPEN_TO_ALL=false

# ====================================================================
# Números de WhatsApp — guía
# ====================================================================
#
# Hay 4 conceptos distintos de "número":
#
#  1) OPENWA_SESSION_PHONE  → el número del bot (cuenta escaneada en OpenWA).
#                              Este número es siempre admin automáticamente.
#
#  2) TEST_WHATSAPP_CHAT_ID → número al que se envían mensajes desde los botones
#                              "Enviar test WhatsApp" del dashboard.
#
#  3) ALLOWED_CHAT_IDS      → whitelist de chatIds con permiso para interactuar
#                              con el bot. Si está vacía, NADIE puede salvo admins
#                              (a menos que OPEN_TO_ALL=true).
#
#  4) ADMIN_CHAT_IDS        → chatIds con permisos de admin (modos, whitelist,
#                              modelo, modo, etc.). OPENWA_SESSION_PHONE se añade
#                              automáticamente a esta lista.
# ====================================================================

TEST_WHATSAPP_CHAT_ID=34670209033@c.us
ALLOWED_CHAT_IDS=
ADMIN_CHAT_IDS=

# ====================================================================
# Polling (fallback al webhook)
# Si OpenWA no dispara webhooks para self-chat, el polling pregunta
# cada X ms si hay mensajes nuevos.
# ====================================================================
POLL_ENABLED=true
POLL_INTERVAL_MS=5000

# ====================================================================
# Telegram Bot
# Crea tu bot con @BotFather en Telegram:
#   1. Abre Telegram → busca @BotFather → /start
#   2. /newbot → dale nombre → te da el TOKEN
#   3. Pega el token en TELEGRAM_BOT_TOKEN
#   4. Abre tu nuevo bot, manda /start, usa /quien para ver tu id
#   5. Mete tu id en TELEGRAM_ALLOWED_USER_IDS
# ====================================================================
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_POLL_INTERVAL_MS=2000
